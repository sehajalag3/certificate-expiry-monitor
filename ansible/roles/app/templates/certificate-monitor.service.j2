[Unit]
Description=Certificate Expiry Monitor container
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ app_user_name }}
Group={{ app_group }}
WorkingDirectory={{ app_home }}
EnvironmentFile={{ app_home }}/app.env
ExecStartPre=-/usr/bin/docker rm -f certificate-monitor
ExecStart=/usr/bin/docker run --name certificate-monitor \
  --env-file {{ app_home }}/app.env \
  --publish {{ app_port }}:{{ app_container_port }} \
  --volume {{ app_home }}/data:/app/data \
  --restart unless-stopped \
  {{ app_image }}
ExecStop=/usr/bin/docker stop -t 10 certificate-monitor
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
